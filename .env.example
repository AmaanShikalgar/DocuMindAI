GROQ_API_KEY=your_groq_key_here
# Optional overrides
# LLM_MODEL=openai/gpt-oss-120b
# LLM_REASONING_EFFORT=low
# LLM_PRICE_IN_PER_M=0.15
# LLM_PRICE_OUT_PER_M=0.60
# CHUNKING=structure        # fixed | structure
# RETRIEVAL=hybrid          # dense | bm25 | hybrid
# RERANK=true
# RATE_LIMIT_QUERIES=30     # per client per 10 min; 0 disables
# Public demo (set in the Dockerfile)
# DEMO_DIR=/app/demo        # PDFs indexed at startup, visible to everyone, not removable
# PRIVATE_UPLOADS=true      # each browser sees only its own uploads and query log
